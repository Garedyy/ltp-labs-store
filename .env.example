# Secret used to sign the cart session cookie. Required in production.
SESSION_SECRET=change-me

# Base URL of the products API (the e2e suite points it at the local mock API).
DUMMYJSON_BASE_URL=https://dummyjson.com

# Public origin used for hreflang links when the app runs behind a proxy (optional).
APP_ORIGIN=

# Set to "true" only when serving over HTTPS.
COOKIE_SECURE=false

PORT=3000
